  mergeRevertDays         Int?     @default(30)
  eligibilityCacheMinutes Int?     @default(60)
  creditReviewDays        Int?     @default(60)
  minStatementMinor       BigInt   @default(500)
  recallLeadDays          Int?     @default(30)
  sessionHours            Int?     @default(12)
  breakGlassMinutes       Int?     @default(60)
  strictAgentOwnerSoD     Boolean  @default(true)
  aiAutonomyAllowed       Boolean  @default(false)
  requireStaffMfa         Boolean  @default(true)
  version                 Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
}

model ProviderProfile {
  id                   String       @id @default(cuid())
  user                 User?        @relation("ProviderProfile_user", fields: [userId], references: [id])
  userId               String?      @unique @map("user")
  displayName          String       @default("")
  abbreviation         String       @unique @default("")
  providerType         String       @default("dentist")
  specialty            String       @default("general")
  npiType1             String?      @unique
  taxonomyCode         String       @default("")
  credentials          Credential[] @relation("Credential_holder")
  payerProviderIds     Json?        @default("{}")
  supervisionClass     String       @default("")
  colour               String       @default("#2563eb")
  productionCreditMode String       @default("rendering")
  isActive             Boolean      @default(true)
  isSynthetic          Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now()) @updatedAt
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique @default("")
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model SecretBox {
  id                              String                @id @default(cuid())
  purpose                         String                @default("")
  ciphertext                      String                @default("")
  iv                              String                @default("")
  authTag                         String                @default("")
  keyVersion                      Int?                  @default(1)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @default(now()) @updatedAt
  from_AdapterInstallation_secret AdapterInstallation[] @relation("AdapterInstallation_secret")
  from_InferenceProvider_secret   InferenceProvider[]   @relation("InferenceProvider_secret")
}

model Sequence {
  id        String @id @default(cuid())
  key       String @unique @default("")
  nextValue Int    @default(1)
}

model StaffAssignment {
  id         String    @id @default(cuid())
  user       User?     @relation("StaffAssignment_user", fields: [userId], references: [id])
  userId     String?   @map("user")
  location   Location? @relation("StaffAssignment_location", fields: [locationId], references: [id])
  locationId String?   @map("location")
  role       Role?     @relation("StaffAssignment_role", fields: [roleId], references: [id])
  roleId     String?   @map("role")
  startsOn   DateTime  @postgresql.Date
  endsOn     DateTime? @postgresql.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([locationId])
  @@index([roleId])
  @@index([userId, locationId], map: "StaffAssignment_user_location_idx")
}

model AgentIdentity {
  id                                    String              @id @default(cuid())
  name                                  String              @unique @default("")
  purpose                               String              @default("")
  kind                                  String              @default("llm_agent")
  inferenceProvider                     InferenceProvider?  @relation("AgentIdentity_inferenceProvider", fields: [inferenceProviderId], references: [id])
  inferenceProviderId                   String?             @map("inferenceProvider")
  owner                                 User?               @relation("AgentIdentity_owner", fields: [ownerId], references: [id])
  ownerId                               String?             @map("owner")
  status                                String              @default("active")
  oauthApp                              OAuthApp?           @relation("AgentIdentity_oauthApp", fields: [oauthAppId], references: [id])
  oauthAppId                            String?             @map("oauthApp")
  grants                                AgentToolGrant[]    @relation("AgentToolGrant_agent")
  runs                                  AgentRun[]          @relation("AgentRun_agent")
  version                               Int                 @default(0)
  createdAt                             DateTime            @default(now())
  updatedAt                             DateTime            @default(now()) @updatedAt
  from_ApprovalRequest_requestedByAgent ApprovalRequest[]   @relation("ApprovalRequest_requestedByAgent")
  from_AuditEvent_actorAgent            AuditEvent[]        @relation("AuditEvent_actorAgent")
  from_MachineCredential_agent          MachineCredential[] @relation("MachineCredential_agent")
  from_PhiReadAudit_actorAgent          PhiReadAudit[]      @relation("PhiReadAudit_actorAgent")
  from_Proposal_proposedByAgent         Proposal[]          @relation("Proposal_proposedByAgent")

  @@index([inferenceProviderId])
  @@index([ownerId])
  @@index([oauthAppId])
}

model AgentToolGrant {
  id          String           @id @default(cuid())
  agent       AgentIdentity?   @relation("AgentToolGrant_agent", fields: [agentId], references: [id])
  agentId     String?          @map("agent")
  scope       String
  constraints Json?
  status      String           @default("requested")
  approval    ApprovalRequest? @relation("AgentToolGrant_approval", fields: [approvalId], references: [id])
  approvalId  String?          @map("approval")
  revokedAt   DateTime?
  version     Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([agentId])
  @@index([approvalId])
  @@index([agentId, scope], map: "AgentToolGrant_agent_scope_idx")
}

model AgentRun {
  id                  String             @id @default(cuid())
  agent               AgentIdentity?     @relation("AgentRun_agent", fields: [agentId], references: [id])
  agentId             String?            @map("agent")
  inferenceProvider   InferenceProvider? @relation("AgentRun_inferenceProvider", fields: [inferenceProviderId], references: [id])
  inferenceProviderId String?            @map("inferenceProvider")
  model               String             @default("")
  startedAt           DateTime?          @default(now())
  endedAt             DateTime?
  status              String             @default("started")
  promptHash          String             @default("")
  toolCalls           Json?
  tokens              Json?
  costMinor           BigInt?
  proposals           Proposal[]         @relation("Proposal_agentRun")
  version             Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt

  @@index([agentId])
  @@index([inferenceProviderId])
}

model Proposal {
  id                    String           @id @default(cuid())
  kind                  String
  payload               Json?
  payloadHash           String           @default("")
  expectedImpact        Json?
  status                String           @default("proposed")
  agentRun              AgentRun?        @relation("Proposal_agentRun", fields: [agentRunId], references: [id])
  agentRunId            String?          @map("agentRun")
  proposedByAgent       AgentIdentity?   @relation("Proposal_proposedByAgent", fields: [proposedByAgentId], references: [id])
  proposedByAgentId     String?          @map("proposedByAgent")
  proposedByUser        User?            @relation("Proposal_proposedByUser", fields: [proposedByUserId], references: [id])
  proposedByUserId      String?          @map("proposedByUser")
  location              Location?        @relation("Proposal_location", fields: [locationId], references: [id])
  locationId            String?          @map("location")
  targetList            String           @default("")
  targetId              String           @default("")
  approval              ApprovalRequest? @relation("Proposal_approval", fields: [approvalId], references: [id])
  approvalId            String?          @map("approval")
  validation            Json?
  execution             Json?
  realised              Json?
  expiresAt             DateTime?
  autonomyPolicyVersion Int?
  version               Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt

  @@index([agentRunId])
  @@index([proposedByAgentId])
  @@index([proposedByUserId])
  @@index([locationId])
  @@index([targetId])
  @@index([approvalId])
}

enum UserKindType {
  staff
  patient_portal
  auditor
  machine
}
